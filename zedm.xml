<!-- This file will eventually be camera only xml. -->

<mujoco model="zedmini_model">

    <compiler angle="degree" meshdir = "assets"/>
    
    <default>
        <default class="camera"> 
            <site size="0.005" rgba="1 0 0 1" group="5"/>
        </default>
    </default>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
            markrgb="0.8 0.8 0.8" width="300" height="300"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
        <mesh name="zedm_mesh" file="zedmini_camera.obj" scale="0.001 0.001 0.001"/>

        <mesh name = "ring_mesh" file = "ring.obj" scale = "0.00133 0.00133 0.00133"/>
        <mesh name = "tire_mesh" file = "tire.obj" scale = "0.00133 0.00133 0.00133"/>

        <material name = "tire_rubber" rgba = "0.1 0.1 0.1 1" />
        <material name = "ring_metal" rgba = "0.8 0.2 0.2 1" />
    </asset>

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global azimuth="150" elevation="-20"/>
    </visual>

    <worldbody>
        <light pos="0 0 3" dir="0 0 -1" directional="false"/>
        <geom name="floor" size="0 0 .125" type="plane" material="groundplane" conaffinity="15" condim="3"/>
 
        <!-- Rover Body-->
        <body name="rover_chassis" pos="0 0 0.13">
            <freejoint name="rover_root"/> 
            <geom type="box" size="0.1 0.09 0.08" rgba="0.8 0.2 0.2 1" mass="1.0"/>
            <geom type="sphere" size="0.015" pos="0.08 0 -0.015" friction="0 0 0" rgba="0.2 0.2 0.2 1"/>

            <body name="left_wheel_back" pos="-0.06 0.08 -0.08">
                <joint name="left_motor_back_joint" type="hinge" axis="0 1 0"/>
                <geom type="mesh" mesh="ring_mesh" euler="-90 0 0" material="ring_metal" />
                <geom type="mesh" mesh="tire_mesh" euler="-90 0 0" material="tire_rubber" />
                <geom type="cylinder" size="0.04 0.05" zaxis="0 1 0" rgba="0 0 0 0" group="0"/>
            </body>

            <body name="right_wheel_back" pos="-0.06 -0.08 -0.08">
                <joint name="right_motor_back_joint" type="hinge" axis="0 1 0"/>
                <geom type="mesh" mesh="ring_mesh" euler="90 0 0" material="ring_metal" />
                <geom type="mesh" mesh="tire_mesh" euler="90 0 0" material="tire_rubber" />
                <geom type="cylinder" size="0.04 0.05" zaxis="0 1 0" rgba="0 0 0 0" group="0"/>
            </body>

            <body name="left_wheel_front" pos="0.06 0.08 -0.08">
                <joint name="left_motor_front_joint" type="hinge" axis="0 1 0"/>
                <geom type="mesh" mesh="ring_mesh" euler="-90 0 0" material="ring_metal" />
                <geom type="mesh" mesh="tire_mesh" euler="-90 0 0" material="tire_rubber" />
                <geom type="cylinder" size="0.04 0.05" zaxis="0 1 0" rgba="0 0 0 0" group="0"/>
            </body>
 
            <body name="right_wheel_front" pos="0.06 -0.08 -0.08">
                <joint name="right_motor_front_joint" type="hinge" axis="0 1 0"/>
                <geom type="mesh" mesh="ring_mesh" euler="90 0 0" material="ring_metal" />
                <geom type="mesh" mesh="tire_mesh" euler="90 0 0" material="tire_rubber" />
                <geom type="cylinder" size="0.04 0.05" zaxis="0 1 0" rgba="0 0 0 0" group="0"/>
            </body>
            
            <body name="zed_mini" euler="0 0 0" pos="0.1 0 0.05">
                <geom type="mesh" euler = "90 0 -20" mesh="zedm_mesh" group="4"/>
                <camera name="perspective" euler="0 -60 0" resolution="64 64" fovy="60" output = "depth" mode = "fixed"
                    projection = "perspective"/>
                <site name = "zedm_site"  size="0.005"  type = "sphere"/>
                <!-- <camera name="zedm_lens" pos="0 0 0" mode = "fixed" output = "depth"/> -->
            </body>
        </body>

        <!-- Test Obstacle for Depth -->
        <body name = "obstacle" pos="0.33 0 0.05">
            <geom type="box" size="0.05 0.05 0.05" rgba="0.2 0.8 0.2 1"/>
        </body>
    </worldbody>

    <!-- Actuators -->
    <actuator>
        <velocity name="left_drive_back" joint="left_motor_back_joint"/>
        <velocity name="right_drive_back" joint="right_motor_back_joint"/>
        <velocity name="left_drive_front" joint="left_motor_front_joint"/>
        <velocity name="right_drive_front" joint="right_motor_front_joint"/>
    </actuator>

    <!-- Sensors -->
    <sensor>
        <rangefinder name ="zedm_perspective" camera="perspective" data = "dist point normal depth"/>
        <gyro name = "zedm_gyro" site = "zedm_site"/>
        <accelerometer name = "zedm_accel" site = "zedm_site"/>
    </sensor>

</mujoco>